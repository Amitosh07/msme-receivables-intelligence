# ---------------------------------------------------------------------------
# Host development (uvicorn + worker on this machine, Redis from
# docker-compose.dev.yml). Production-like environments refuse to start with
# placeholder values; development only logs a warning.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/msme_receivables

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ENVIRONMENT=development

# Comma-separated browser origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Interactive docs (/docs, /redoc, /openapi.json) default to on only in development.
# API_DOCS_ENABLED=false

# Storage (Local object-storage abstraction)
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
MAX_INVOICE_FILE_SIZE_MB=10
# 32-byte key, base64. Generate with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Leave empty in development to store plaintext. To encrypt files written
# before the key was set: python -m backend.app.services.storage.encrypt_existing --apply
STORAGE_ENCRYPTION_KEY=
# Old keys still accepted for reading during rotation (comma-separated).
STORAGE_ENCRYPTION_PREVIOUS_KEYS=
STORAGE_ALLOW_PLAINTEXT_READS=true

# Redis Task Queue
REDIS_URL=redis://localhost:6379/0
REDIS_TASK_QUEUE_NAME=msme_tasks

# Rate limits (per client IP unless noted; counters shared through Redis)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_HOUR=30
RATE_LIMIT_REGISTER_PER_HOUR=10
# Per business tenant:
RATE_LIMIT_UPLOADS_PER_MINUTE=30
RATE_LIMIT_DEMO_PER_MINUTE=5

# ---------------------------------------------------------------------------
# Full stack (docker compose up -d --build). Compose reads these from this
# file; `docker compose` refuses to start while any required one is missing.
# Use URL-safe values (letters, digits, - and _) for the passwords, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY and STORAGE_ENCRYPTION_KEY above are shared with the stack.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# POSTGRES_USER=msme
# POSTGRES_DB=msme_receivables
# WEB_PORT=8080
# WEB_BIND=127.0.0.1
# STACK_ENVIRONMENT=production
# STACK_CORS_ORIGINS=http://localhost:8080
